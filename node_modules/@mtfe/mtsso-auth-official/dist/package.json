{
  "name": "@mtfe/mtsso-auth-official",
  "version": "1.0.10",
  "type": "commonjs",
  "main": "./index.cjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./client-credentials": {
      "import": "./client-credentials.mjs",
      "require": "./client-credentials.cjs"
    },
    "./token-exchange": {
      "import": "./token-exchange.mjs",
      "require": "./token-exchange.cjs"
    },
    "./introspect-token": {
      "import": "./introspect-token.mjs",
      "require": "./introspect-token.cjs"
    },
    "./moa-local-exchange": {
      "import": "./moa-local-exchange.mjs",
      "require": "./moa-local-exchange.cjs"
    },
    "./moa-feature-probe": {
      "import": "./moa-feature-probe.mjs",
      "require": "./moa-feature-probe.cjs"
    },
    "./agent-info-register": {
      "import": "./agent-info-register.mjs",
      "require": "./agent-info-register.cjs"
    },
    "./mtsso-configs": {
      "import": "./mtsso-configs.mjs",
      "require": "./mtsso-configs.cjs"
    },
    "./scripts/*": "./scripts/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "mtsso-client-credentials": "scripts/client_credentials.js",
    "mtsso-token-exchange": "scripts/token_exchange.js",
    "mtsso-introspect-token": "scripts/introspect_token.js",
    "mtsso-moa-local-exchange": "scripts/moa_local_exchange.js",
    "mtsso-moa-feature-probe": "scripts/moa_feature_probe.js",
    "mtsso-configs": "scripts/mtsso_configs.js",
    "mtsso-agent-info-register": "scripts/agent_info_register.js"
  }
}
